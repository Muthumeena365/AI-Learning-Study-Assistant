# -----------------------------
# RAG TOOL
# -----------------------------

def rag_search(question):

    question = question.lower()

    best_match = None
    best_score = 0

    for keyword in course_material:

        words = keyword.split()

        score = 0

        for word in words:
            if word in question:
                score += 1

        if score > best_score:
            best_score = score
            best_match = keyword

    if best_match:
        return course_material[best_match]

    return (
        "Sorry, I could not find relevant information "
        "in the course material."
    )


# -----------------------------
# STUDY PLAN TOOL
# -----------------------------

def create_study_plan():

    print("\n--- STUDY PLAN GENERATOR ---")

    subject = input("Enter subject: ")

    days = int(input("Enter number of days: "))

    topics = input(
        "Enter topics separated by comma: "
    )

    topic_list = topics.split(",")

    print("\nYour Personalized Study Plan\n")

    for i in range(days):

        topic = topic_list[i % len(topic_list)].strip()

        print(
            "Day", i + 1,
            "->",
            subject,
            ":", topic
        )


